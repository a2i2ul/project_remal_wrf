&time_control
 run_days                            = 0,
 run_hours                           = 120,
 run_minutes                         = 0,
 run_seconds                         = 0,
 start_year                          = 2024, 2024,
 start_month                         = 05,   05, 
 start_day                           = 24,   24,
 start_hour                          = 00,   00,
 end_year                            = 2024, 2024,
 end_month                           = 05,   05,
 end_day                             = 29,   29,
 end_hour                            = 00,   00,
 interval_seconds                    = 21600,
 input_from_file                     = .true.,.true.,
 history_interval                    = 180,  180,
 frames_per_outfile                  = 1, 1,
 restart                             = .false.,
 restart_interval                    = 0,
 io_form_history                     = 2,
 io_form_restart                     = 2,
 io_form_input                       = 2,
 io_form_boundary                    = 2,
 auxinput4_inname                    = "wrflowinp_d<domain>",
 auxinput4_interval                  = 360, 360,
 auxinput4_end_h                     = 120, 120,  ! -- -Or your total run hours 
 io_form_auxinput4                   = 2,
 /

 &domains
 time_step                           = 90,
 time_step_fract_num                 = 0,
 time_step_fract_den                 = 1,
 max_dom                             = 2,
 e_we                                = 190,    280,
 e_sn                                = 190,    280,
 e_vert                              = 45,     45,
 dzbot                               = 30.,
 dzstretch_s                         = 1.11,
 dzstretch_u                         = 1.10,
 p_top_requested                     = 10000,
 
 !nproc_x                             = 3,       ! ADD THIS: Core split in X
 !nproc_y                             = 2,       ! ADD THIS: Core split in Y
 
 num_metgrid_levels                  = 34,       ! fnl/gfs uses 34 and cfs era5 uses 38
 num_metgrid_soil_levels             = 4,
 dx                                  = 27000,
 dy                                  = 27000,
 grid_id                             = 1,     2,
 parent_id                           = 0,     1,
 i_parent_start                      = 1,     47,
 j_parent_start                      = 1,     47,
 parent_grid_ratio                   = 1,     3,
 parent_time_step_ratio              = 1,     3,
 feedback                            = 1,
 smooth_option                       = 2
 /

 &physics
 physics_suite                       = 'tropical'
 sst_update                          = 1,
 isftcflx                            = 1,    ! 1 = Donelan relation (best for hurricanes/cyclones)
 mp_physics                          = 8,    8,
 cu_physics                          = 1,    0,
 ra_lw_physics                       = 1,    1,
 ra_sw_physics                       = 1,    1,
 bl_pbl_physics                      = 1,    1,
 sf_sfclay_physics                   = 1,    1,
 sf_surface_physics                  = 2,    2,
 radt                                = 27,    9,
 bldt                                = 0,     0,
 cudt                                = 0,     0,
 icloud                              = 1,
 num_land_cat                        = 21,
 sf_urban_physics                    = 0,     0,
 fractional_seaice                   = 1,
 /

 &fdda
 /

 &dynamics
 hybrid_opt                          = 2, 
 w_damping                           = 1,
 diff_opt                            = 1,      1,
 km_opt                              = 4,      4,
 diff_6th_opt                        = 0,      0,
 diff_6th_factor                     = 0.12,   0.12,
 base_temp                           = 290.,
 damp_opt                            = 3,
 zdamp                               = 5000.,  5000.,
 dampcoef                            = 0.2,    0.2,
 khdif                               = 0,      0,
 kvdif                               = 0,      0,
 non_hydrostatic                     = .true., .true.,
 moist_adv_opt                       = 1,      1,
 scalar_adv_opt                      = 1,      1,
 gwd_opt                             = 1,      1,
 /

 &bdy_control
 spec_bdy_width = 5,
 spec_zone      = 1,
 relax_zone     = 4,
 specified      = .true., .false.,
 nested         = .false., .true.,
/


 &namelist_quilt
 nio_tasks_per_group = 0,
 nio_groups = 1,
 /



